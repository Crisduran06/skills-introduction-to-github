# bid-intel environment configuration
DATABASE_URL=sqlite:///./bid_intel.db
DEBUG=false
LOG_LEVEL=INFO

# Server
HOST=127.0.0.1
PORT=8000

# Scheduler
SCHEDULER_ENABLED=false
FETCH_HOUR=6
FETCH_MINUTE=0
RESULTS_CHECK_HOUR=7
RESULTS_CHECK_MINUTE=0
SHEETS_SYNC_DAY=mon
SHEETS_SYNC_HOUR=8
SHEETS_SYNC_MINUTE=0

# Google Sheets (optional)
GOOGLE_SHEETS_CREDENTIALS_FILE=
GOOGLE_SHEETS_SPREADSHEET_ID=

# Playwright (optional, for dynamic public pages)
PLAYWRIGHT_HEADLESS=true
